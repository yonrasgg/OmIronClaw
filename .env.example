# OmIronClaw environment template
# Copy to .env and customize for your host.

# Host identity
PI_HOSTNAME="omironclaw-node"
PI_IP="10.0.0.10"
GATEWAY_IP="10.0.0.1"

# Network
LAN_SUBNET="10.0.0.0/24"
USB_TETHER_SUBNET="10.42.0.0/24"

# Access
SSH_USER="admin"
KALI_USER="auditor"
KALI_IP="10.0.0.20"
LAB_IP="10.0.0.30"
COMPUTE_IP="10.0.0.31"
ADMIN_PC_IP="10.0.0.40"
IOT_BLOCK_IP="10.0.0.250"

# API gateway auth placeholder (real value should be stored in /etc/caddy/api-key.env)
OLLAMA_API_KEY="CHANGE_ME_API_KEY"

# AI mode
AI_MODE="hybrid"  # local | cloud | hybrid
LOCAL_MODELS="qwen2.5:7b,phi4-mini"
PRIMARY_PROVIDER="google"
FALLBACK_PROVIDER="openai"
